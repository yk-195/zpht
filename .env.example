# 复制为本地 .env；已有配置不要覆盖。真实密钥不得提交。
SERVICE_NAME=求职申请表·问卷调查服务
SERVICE_VERSION=0.1.0
ENV=dev
DEBUG=true
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://127.0.0.1:8000
QUESTIONNAIRE_PATH=/q
CORS_ORIGINS=*
LOG_LEVEL=INFO
UI_ENABLED=true

DATABASE_URL=sqlite:///./data/service.db
DB_ECHO=false
DB_CREATE_TABLES=true
DATA_DIR=./data

# 留空仅供本机联调；部署时设置随机密钥。
SERVICE_API_KEY=
TOKEN_TTL_DAYS=7
TOKEN_BYTES=32
ALLOW_RESUBMIT=true
AUTO_COMPLETE_ON_SUBMIT=true

FAMILY_MAX_ROWS=5
FAMILY_RELATION_OPTIONS=父亲,母亲,配偶,子,女,兄,弟,姐,妹,其他
HEALTH_OPTIONS=良好,一般,较差
